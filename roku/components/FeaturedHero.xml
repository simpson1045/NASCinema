<?xml version="1.0" encoding="utf-8" ?>
<!-- Auto-advancing featured hero: backdrop + trailer video + clearlogo +
     ratings/quality, with paging dots. It always fills the whole 1920x1080 behind
     the home screen (Netflix-style): on home, `homeScrim` fades it into the rails
     at the bottom and darkens the left for the logo + overview; focused, it goes
     fullscreen with the info in the lower-left. Transitions
     fade through `fader` (a black overlay), which covers the video plane that
     ignores opacity. Trailer plays muted while idle; audio comes on when `active`. -->
<component name="FeaturedHero" extends="Group">
  <script type="text/brightscript" uri="pkg:/components/FeaturedHero.brs" />
  <interface>
    <field id="featured" type="array" onChange="onFeatured" />
    <field id="base" type="string" />
    <!-- True while the user is focused on the hero: unmute + pause auto-advance. -->
    <field id="active" type="boolean" value="false" onChange="onActiveChange" />
    <!-- Set true while a fullscreen movie plays, so the hero stops its trailer. -->
    <field id="suspended" type="boolean" value="false" onChange="onSuspendedChange" />
    <!-- Set to the chosen movie id when OK is pressed on the hero. -->
    <field id="playMovieId" type="integer" alwaysNotify="true" />
  </interface>
  <children>
    <Group id="content">
      <Poster id="backdrop" width="1920" height="1080"
          loadDisplayMode="scaleToFill" />
      <!-- Never zoomed or cropped (that chopped titles/text off). A letterboxed
           trailer is slid up by its top bar (playTrailer, from the server's
           trailer_bars) so the picture starts at the screen's top edge. -->
      <Video id="trailer" width="1920" height="1080"
          mute="true" visible="false" enableUI="false" />
      <!-- Home: fade into the rails + darken the left. Fullscreen: the original
           lower-left scrim. Only one is visible at a time (setMode). -->
      <Poster id="homeScrim" width="1920" height="1080" loadDisplayMode="scaleToFill"
          uri="pkg:/images/home_scrim2.png" />
      <Poster id="scrim" width="1920" height="1080" loadDisplayMode="scaleToFill"
          uri="pkg:/images/hero_scrim.png" visible="false" />
      <Poster id="logo" translation="[90,110]" width="520" height="150"
          loadDisplayMode="scaleToFit" />
      <Label id="title" translation="[92,170]" width="1200"
          color="0xFFFFFFFF" font="font:LargeBoldSystemFont" visible="false" />
      <!-- Built in code (buildMeta): year + IMDb logo·rating + RT logo·score +
           quality, laid out left-to-right. itemSpacings is set in code. -->
      <LayoutGroup id="meta" translation="[92,288]" layoutDirection="horiz"
          vertAlignment="center" />
      <Label id="overview" translation="[92,338]" width="760" wrap="true"
          maxLines="3" lineSpacing="4" color="0xDDE2F5FF"
          font="font:SmallSystemFont" />
    </Group>
    <Group id="dots" translation="[92,478]" />
    <!-- Black overlay for fade transitions. Covers the video plane (which ignores
         opacity). -->
    <Rectangle id="fader" width="1920" height="1080" color="0x000000FF" opacity="0" />

    <Timer id="auto" duration="25" repeat="false" />
    <!-- Short delay after a backdrop appears before its trailer starts. -->
    <Timer id="trailerDelay" duration="1.4" repeat="false" />

    <!-- Fade through black: fade `fader` in, swap to the next item, fade it out. -->
    <Animation id="fadeOut" duration="0.35" repeat="false">
      <FloatFieldInterpolator key="[0.0,1.0]" keyValue="[0.0,1.0]"
          fieldToInterp="fader.opacity" />
    </Animation>
    <Animation id="fadeIn" duration="0.35" repeat="false">
      <FloatFieldInterpolator key="[0.0,1.0]" keyValue="[1.0,0.0]"
          fieldToInterp="fader.opacity" />
    </Animation>
  </children>
</component>
