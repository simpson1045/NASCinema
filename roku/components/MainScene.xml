<?xml version="1.0" encoding="utf-8" ?>
<component name="MainScene" extends="Scene">
  <script type="text/brightscript" uri="pkg:/components/MainScene.brs" />
  <children>
    <Rectangle id="bg" width="1920" height="1080" color="0x0A0E27FF" />
    <FeaturedHero id="hero" visible="false" />
    <Label id="status" text="Loading your library…" translation="[0,520]"
        width="1920" horizAlign="center" color="0xEEF1FFFF"
        font="font:MediumBoldSystemFont" />
    <!-- Array-typed fields (rowItemSize, rowHeights, etc.) are set in code in
         init() — as XML attribute strings they parse to garbage silently and the
         rows collapse to ~44px wide. -->
    <!-- Two rows so the next rail always peeks in under the first (Netflix-style);
         the hero stays full-bleed behind them. fixedFocus keeps the focused rail
         in the top slot and scrolls the rails up under it (floatingFocus let focus
         drop onto the half-off-screen second row). Per-row sizes are set in code. -->
    <RowList id="rows" translation="[90,540]"
        itemComponentName="MoviePoster"
        numRows="2"
        vertFocusAnimationStyle="fixedFocus"
        rowFocusAnimationStyle="fixedFocusWrap"
        visible="false" />
    <Video id="video" width="1920" height="1080" translation="[0,0]"
        visible="false" />
  </children>
</component>
