# Copy to /mnt/NAS Storage/apps/nascinema/.env (chmod 600). Compose reads
# POSTGRES_PASSWORD; the backend reads the NASCINEMA_* keys (env_file).
POSTGRES_PASSWORD=change-me
NASCINEMA_SECRET_KEY=change-me-to-a-long-random-string
NASCINEMA_TMDB_API_KEY=
NASCINEMA_OMDB_API_KEY=
NASCINEMA_OPENSUBTITLES_API_KEY=
NASCINEMA_CONTRIBUTE_EXTRAS=false
NASCINEMA_TRANSCODE_CACHE_GB=20
# Renderer wake-on-LAN (ELKO). Blank = disabled.
NASCINEMA_RENDERER_MAC=
NASCINEMA_WOL_BROADCAST=192.168.0.255
